rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApproved() {
      return isAdmin() || (isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection - profile data
    match /users/{userId} {
      // Members can read their own application; admins can manage the directory.
      allow read: if isOwner(userId) || isAdmin();

      // New accounts can only create a pending, non-admin application.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending';

      // Members may edit basic profile fields but cannot approve or promote themselves.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'voicePart']);

      // Admins can review applications and manage profiles.
      allow write: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      // Only approved members can see choir events.
      allow read: if isApproved();

      // Only admins can create events
      allow create: if isAdmin();

      // Only admins can update/delete events
      allow update, delete: if isAdmin();
    }

    // Attendance collection - nested under events
    match /events/{eventId}/attendance/{userId} {
      // Only approved members can see attendance.
      allow read: if isApproved();

      // Approved users can set/update their own attendance, but the
      // denormalized voicePart must match their real profile - it cannot
      // be self-reported to something false.
      allow create, update: if isApproved() && isOwner(userId)
        && request.resource.data.voicePart ==
           get(/databases/$(database)/documents/users/$(userId)).data.voicePart;

      // Approved users can clear (delete) their own attendance.
      allow delete: if isApproved() && isOwner(userId);

      // Admins can write any attendance
      allow write: if isAdmin();
    }

    // Collection-group rule: required separately from the nested match above
    // because Firestore only honors the {path=**} wildcard form for
    // collectionGroup() queries (used to read attendance across all events
    // at once for the Attendance dashboard).
    match /{path=**}/attendance/{userId} {
      allow read: if isApproved();
    }

    // Editable member-facing portal content.
    match /content/{documentId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Songs collection - admin managed
    match /songs/{songId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApproved() {
      return isAdmin() || (isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection - profile data
    match /users/{userId} {
      // Personal profiles are never exposed as a collection to non-admins.
      allow read: if isOwner(userId) || isAdmin();

      // New accounts can only create a pending, non-admin application.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending';

      // Members may edit basic profile fields but cannot approve or promote themselves.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'voicePart']);

      // Login stats are recorded by the signed-in user on their own doc.
      // loginCount may only advance by exactly 1 per write - it cannot be
      // set to an arbitrary value.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginCount', 'lastLoginAt'])
        && request.resource.data.loginCount == resource.data.get('loginCount', 0) + 1;

      // Admins can review applications and manage profiles.
      allow write: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      // Only approved members can see choir events.
      allow read: if isApproved();

      // Only admins can create events
      allow create: if isAdmin();

      // Only admins can update/delete events
      allow update, delete: if isAdmin();
    }

    // Attendance collection - nested under events
    match /events/{eventId}/attendance/{userId} {
      // Only approved members can see attendance.
      allow read: if isApproved();

      // Approved users can set/update their own attendance, but the
      // denormalized voicePart must match their real profile - it cannot
      // be self-reported to something false.
      allow create, update: if isApproved() && isOwner(userId)
        && request.resource.data.keys().hasOnly(['status', 'voicePart', 'updatedAt'])
        && request.resource.data.keys().hasAll(['status', 'voicePart', 'updatedAt'])
        && request.resource.data.status in ['yes', 'maybe', 'no']
        && request.resource.data.voicePart is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40
        && request.resource.data.voicePart ==
           get(/databases/$(database)/documents/users/$(userId)).data.voicePart;

      // Approved users can clear (delete) their own attendance.
      allow delete: if isApproved() && isOwner(userId);

      // Admins can write any attendance
      allow write: if isAdmin();
    }

    // Collection-group rule: required separately from the nested match above
    // because Firestore only honors the {path=**} wildcard form for
    // collectionGroup() queries (used to read attendance across all events
    // at once for the Attendance dashboard).
    match /{path=**}/attendance/{userId} {
      allow read: if isApproved();
    }

    // Editable member-facing portal content.
    match /content/{documentId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Account lifecycle records are only written by the trusted Admin SDK
    // function. Browser clients must not read, forge or delete them.
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // Songs collection - admin managed
    match /songs/{songId} {
      allow read: if isApproved();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'url', 'choirs', 'linkedFilePath', 'linkedFileName',
          'linkedFileContentType', 'linkedFiles', 'createdAt', 'updatedAt',
          'resourceVersion', 'resourceDate', 'rightsNotes', 'archivedAt'
        ])
        && request.resource.data.keys().hasAll(['title', 'url', 'choirs'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.url is string
        && (request.resource.data.url == '' || request.resource.data.url.matches('^https://[^\\s]+$'))
        && request.resource.data.choirs is list
        && request.resource.data.get('linkedFiles', []) is list
        && request.resource.data.get('linkedFiles', []).size() <= 20
        && request.resource.data.get('linkedFilePath', '') is string
        && (request.resource.data.get('linkedFilePath', '') == ''
          || request.resource.data.get('linkedFilePath', '').matches('^shared/[^/]+$'))
        && request.resource.data.get('linkedFileName', '') is string
        && request.resource.data.get('linkedFileName', '').size() <= 255
        && request.resource.data.get('linkedFileContentType', '') is string
        && request.resource.data.get('linkedFileContentType', '').size() <= 150
        && request.resource.data.get('resourceVersion', '') is string
        && request.resource.data.get('resourceVersion', '').size() <= 80
        && request.resource.data.get('resourceDate', '') is string
        && request.resource.data.get('resourceDate', '').matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.get('rightsNotes', '') is string
        && request.resource.data.get('rightsNotes', '').size() <= 1000
        && request.resource.data.get('archivedAt', '') is string
        && request.resource.data.get('archivedAt', '').size() <= 40;
      allow delete: if isAdmin();
    }

  }
}
